        "scheme_name": "Ayushman Bharat - PMJAY (Verified Data)",
        "state": "Central",
        "sector": "Medical",
        "category": "Insurance",
        "description": "Verified health cover of Rs. 5 lakhs per family per year for secondary and tertiary care hospitalization.",
        "eligibility_criteria": [
            "Belong to poor and vulnerable families based on SECC 2011.",
            "No age or family size limit."
        ],
        "required_documents": [
            "Aadhaar Card",
            "Ration Card",
            "PMJAY e-Card"
        ],
        "application_steps": [
            "Visit nearest empanelled hospital.",
            "Provide Aadhaar card to the Ayushman Mitra.",
            "Verify identity via fingerprint or OTP.",
            "Receive the PMJAY e-Card."
        ]
    },
